=nn.Linear(8,2)\n    def forward(self,x):\n        return self.fc2(self.fc1(x))\nmodel=RegressionModel()\nprint(model)","key":"oKP46vXmVn"},{"type":"outputs","id":"yjU1rbZGRFsmt-WNR-RM8","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"RegressionModel(\n  (fc1): Linear(in_features=3, out_features=8, bias=True)\n  (fc2): Linear(in_features=8, out_features=2, bias=True)\n)\n"},"children":[],"key":"Hs1wrbFsH1"}],"key":"Z0aas7IVG4"}],"key":"zUMcR2hDpv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. MSE criterion and SGD optimizer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e5xUSPN3Qk"}],"identifier":"id-3-mse-criterion-and-sgd-optimizer","label":"3. MSE criterion and SGD optimizer","html_id":"id-3-mse-criterion-and-sgd-optimizer","implicit":true,"key":"OcFqSJya6G"}],"key":"r7b5gd4n1W"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T09:54:59.730734Z","iopub.status.busy":"2026-09-21T09:54:59.730629Z","iopub.status.idle":"2026-09-21T09:55:00.762070Z","shell.execute_reply":"2026-09-21T09:55:00.761411Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"criterion=nn.MSELoss()\noptimizer=torch.optim.SGD(model.parameters(),lr=0.01)\nprint('Criterion:',criterion); print('Optimizer: SGD')","key":"wXFwHA79ws"},{"type":"outputs","id":"CMyjbUwedsvcLVPXCXcRr","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Criterion: MSELoss()\nOptimizer: SGD\n"},"children":[],"key":"L8TALGfXvc"}],"key":"UX2rRHLMYw"}],"key":"qJA6gTtoAO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Train for 1000 epochs","position":{"start":{