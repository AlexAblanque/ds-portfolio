,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Output = floor((Input + 2P − K) / S) + 1","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Q3QkEYC8A1"}],"key":"FAuDNifTIF"}],"key":"FVfJB7OflS"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"where:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ItWnxOtEft"}],"key":"Utf4Owse5x"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"P","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"dgnuf5ftKY"},{"type":"text","value":" = padding","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"xkhBSvw29L"}],"key":"OjL3ArApRZ"}],"key":"N5ccQClLhA"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"K","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"b0ra1ZpUpu"},{"type":"text","value":" = kernel size","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"LDdN58Tr2Y"}],"key":"uEdVNnjLU7"}],"key":"JIdPmSqAxq"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"S","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"I5HkpOfjrv"},{"type":"text","value":" = stride","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"IsPvjqZthG"}],"key":"gD5CSd5Pf6"}],"key":"vgDtN4fPUf"}],"key":"T3lkwFMUQS"}],"key":"MubYxGnhCP"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T10:11:56.407794Z","iopub.status.busy":"2026-09-21T10:11:56.407560Z","iopub.status.idle":"2026-09-21T10:11:56.412763Z","shell.execute_reply":"2026-09-21T10:11:56.412044Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Spatial dimensions based exactly on the attached architecture\n\n# Input: 28 x 28\n# Conv1: kernel=3, stride=1, padding=1\nconv1_size = ((28 + 2*1 - 3) // 1) + 1\n\n# MaxPool1: kernel=2, stride=1, padding=1\npool1_size = ((conv1_size + 2*1 - 2) // 1) + 1\n\n# Conv2, Conv3, Conv4 all preserve spatial size\nconv2_size = ((pool1_size + 2*1 - 3) // 1) + 1\nconv3_size = ((conv2_size + 2*1 - 3) // 1) + 1\nconv4_size = ((conv3_size + 2*1 - 3) // 1) + 1\n\n# MaxPool2: kernel=2, stride=1, padding=0\npool2_size = ((conv4_size + 2*0 - 2) // 1) + 1\n\nflatten_features = 256 * pool2_size * pool2_size\n\nprint(\"After Conv1   :\", (32, 32, conv1_size, conv1_size))\nprint(\"After MaxPool1:\", (32, 32, pool1_size, pool1_size))\nprint(\"After Conv2   :\", (32, 64, conv2_size, conv2_size))\nprint(\"After Conv3   :\", (32, 128, conv3_size, conv3_size))\nprint(\"After Conv4   :\", (32, 256, conv4_size, conv4_size))\nprint(\"After MaxPool2:\", (32, 256, pool2_size, pool2_size))\nprint(\"Flatten size  :\", flatten_features)\n","key":"Mu8KsrdXwF"},{"type":"outputs","id":"5BG9L7EDI7I142lVlzGaB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"After Conv1   : (32, 32, 28, 28)\nAfter MaxPool1: (32, 32, 29, 29)\nAfter Conv2   : (32, 64, 29, 29)\nAfter Conv3   : (32, 128, 29, 29)\nAfter Conv4   : (32, 256, 29, 29)\nAfter MaxPool2: (32, 256, 28, 28)\nFlatten size  : 200704\n"},"children":[],"key":"E9gLreZL9j"}],"key":"rGhhOPguZO"}],"key":"swd4Cm5VDC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Create the CNN Architecture","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XRAGvhGbmK"}],"identifier":"id-3-create-the-cnn-architecture","label":"3. Create the CNN Architecture","html_id":"id-3-create-the-cnn-architecture","implicit":true,"key":"hOXgiWxiN6"}],"key":"ZzWPh1E1Gr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T10:11:56.415035Z","iopub.status.busy":"2026-09-21T10:11:56.414703Z","iopub.status.idle":"2026-09-21T10:11:56.419926Z","shell.execute_reply":"2026-09-21T10:11:56.419319Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"class CNNLab6(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        # Convolutional layers\n        self.conv1 = nn.Conv2d(\n            in_channels=1,\n            out_channels=32,\n            kernel_size=(3, 3),\n            stride=1,\n            padding=1\n        )\n\n        self.pool1 = nn.MaxPool2d(\n            kernel_size=(2, 2),\n            stride=1,\n            padding=1\n        )\n\n        self.conv2 = nn.Conv2d(\n            in_channels=32,\n            out_channels=64,\n            kernel_size=(3, 3),\n            stride=1,\n            padding=1\n        )\n\n        self.conv3 = nn.Conv2d(\n            in_channels=64,\n            out_channels=128,\n            kernel_size=(3, 3),\n            stride=1,\n            padding=1\n        )\n\n        self.conv4 = nn.Conv2d(\n            in_channels=128,\n            out_channels=256,\n            kernel_size=(3, 3),\n            stride=1,\n            padding=1\n        )\n\n        self.pool2 = nn.MaxPool2d(\n            kernel_size=(2, 2),\n            stride=1,\n            padding=0\n        )\n\n        # Dropout specified in the diagram\n        self.dropout = nn.Dropout(p=0.2)\n\n        # After MaxPool2: 256 x 28 x 28\n        self.fcn1 = nn.Linear(256 * 28 * 28, 1000)\n        self.fcn2 = nn.Linear(1000, 500)\n        self.fcn3 = nn.Linear(500, 10)\n\n    def forward(self, x):\n        # Conv1 -> ReLU -> MaxPool1\n        x = F.relu(self.conv1(x))\n        x = self.pool1(x)\n\n        # Conv2 -> ReLU\n        x = F.relu(self.conv2(x))\n\n        # Conv3 -> ReLU\n        x = F.relu(self.conv3(x))\n\n        # Conv4 -> ReLU -> MaxPool2\n        x = F.relu(self.conv4(x))\n        x = self.pool2(x)\n\n        # Dropout\n        x = self.dropout(x)\n\n        # Flatten\n        x = torch.flatten(x, 1)\n\n        # Fully connected layers\n        x = F.relu(self.fcn1(x))\n        x = F.relu(self.fcn2(x))\n        x = self.fcn3(x)\n\n        # Softmax output\n        x = F.softmax(x, dim=1)\n\n        return x\n","key":"Qvb2xhyDHa"},{"type":"outputs","id":"57TGLomoLVl5RPH6ApPpH","children":[],"key":"TIJI0MMT9E"}],"key":"SdUE8iYsBw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Instantiate the Model","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oA4IloHvhW"}],"identifier":"id-4-instantiate-the-model","label":"4. Instantiate the Model","html_id":"id-4-instantiate-the-model","implicit":true,"key":"dE56VcIZ0s"}],"key":"XHapQdUCq6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-21T10:11:56.421215Z","iopub.status.busy":"2026-09-21T10:11:56.421058Z","iopub.status.idle":"2026-09-21T10:11:58.037103Z","shell.execute_reply":"2026-09-21T10:11:58.036181Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"model = CNNLab6()\nprint(model)\n","key":"pzCZXjL078"},{"type":"outputs","id":"iW_69I6UfvKx430UaX0VI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"CNNLab6(\n  (conv1): Conv2d(1, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1